APP_NAME=Tarot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=hu_HU

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tarot
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

EPHEMERIS_PYTHON_BIN="${APP_BASE_PATH}/.venv/Scripts/python.exe"

# openai (default) or ollama
LLM_DRIVER=openai

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=120

# Local or same-host Ollama:
# LLM_DRIVER=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen2.5:14b
# OPENAI_API_KEY=
# OPENAI_TIMEOUT=300
# LLM_FALLBACK_OPENAI=false
# OLLAMA_SMALL_MODEL=llama3.2
# OLLAMA_LARGE_MODEL=qwen2.5:14b
#
# VPS using this PC's Ollama (SSH reverse tunnel, not a public port):
# 1) ollama pull llama3.2 && ollama pull qwen2.5:14b
# 2) powershell -File deploy/ollama-vps-tunnel.ps1
# 3) on the VPS: LLM_DRIVER=ollama, OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#    LLM_FALLBACK_OPENAI=true keeps OpenAI as backup when the PC is offline
#    Admin → Tesztmód chooses small / large Ollama, or OpenAI only (skip local)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
